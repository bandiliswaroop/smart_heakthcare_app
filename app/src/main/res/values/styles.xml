<resources>

    <!-- Custom TextInput styles -->
    <style name="CustomTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#BDBDBD</item>
        <item name="hintTextColor">#757575</item>
    </style>

    <style name="CustomTextInputEditTextStyle">
        <item name="android:background">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorHint">#757575</item>
    </style>

    <!-- App Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <!-- Common Text Styles -->
    <style name="TextTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#242424</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#424242</item>
    </style>

    <style name="MyTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- ✅ Fixed versions -->
    <style name="TextViewBoldLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="TextViewBold">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#222222</item>
    </style>

    <style name="TextViewNormal">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#444444</item>
    </style>
    <style name="ProfileNavItem">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="ProfileNavTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#6C7A89</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>

