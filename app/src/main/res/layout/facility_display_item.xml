<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="8dp"
    android:background="@drawable/bg_facility_container">

    <TextView android:id="@+id/tvFacilityName"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:text="ICU" />

    <TextView android:id="@+id/tvFacilityCount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="5" android:paddingStart="16dp" />
</LinearLayout>
