<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp"
    android:radius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Image of the technology -->
        <ImageView
            android:id="@+id/imgTech"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="@drawable/rounded_overlay" />

        <!-- Button to pick image -->
        <ImageView
            android:id="@+id/btnPickTechImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_gallery"
            android:background="@drawable/rounded_white"
            android:padding="6dp" />

        <!-- Technology name input -->
        <EditText
            android:id="@+id/etTechName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Technology Name"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_edittext"
            android:padding="8dp" />

        <!-- Remove button -->
        <ImageView
            android:id="@+id/btnRemoveTech"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_remove"
            android:contentDescription="Remove"
            android:background="@drawable/rounded_white"
            android:padding="4dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
