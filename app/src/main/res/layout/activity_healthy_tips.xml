<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F9FF"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvHealthTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Health Tips"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="24dp"/>

    <!-- Tip Items (with unique IDs) -->
    <include layout="@layout/item_tip_button" android:id="@+id/btnFever"/>
    <include layout="@layout/item_tip_button" android:id="@+id/btnCold"/>
    <include layout="@layout/item_tip_button" android:id="@+id/btnHeadache"/>
    <include layout="@layout/item_tip_button" android:id="@+id/btnBackPain"/>
    <include layout="@layout/item_tip_button" android:id="@+id/btnBodyPain"/>
    <include layout="@layout/item_tip_button" android:id="@+id/btnStomachPain"/>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
